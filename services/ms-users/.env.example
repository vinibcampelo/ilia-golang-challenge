# Copy to `.env` (`cp .env.example .env`). The `.env` file is used by:
# - Docker Compose (${...} in docker-compose.yml), loaded automatically when present.
# - `go run` / `make run` via godotenv (DOTENV_FILE, default `.env`).

# --- API (required when running the binary outside Compose) ---
PORT=3002
# Use localhost when connecting to Postgres published on the host (not the Docker network).
DATABASE_URL=postgres://users:users@localhost:5432/users?sslmode=disable

# --- Docker Compose Postgres service (override defaults users/users/users in compose) ---
POSTGRES_USER=users
POSTGRES_PASSWORD=users
POSTGRES_DB=users
POSTGRES_PORT=5432
# Optional: host port published for the API container (container always listens on 3002 for service mesh).
# MS_USERS_HOST_PORT=3002

# Optional: Swagger
# Path is relative to the repository root when using `make run` (Go runs from REPO_ROOT).
OPENAPI_SPEC=services/ms-users/ms-users.yaml

# Optional: API
DB_PING_TIMEOUT=10s
BCRYPT_COST=10

# JWT (required): same secret can be shared with ms-transactions for HS256 validation.
JWT_SECRET=change-me-in-production
# Optional access token lifetime (Go duration, e.g. 24h, 15m).
JWT_EXPIRATION=24h

# --- Internal service-to-service JWT (challenge: ILIACHALLENGE_INTERNAL) ---
# Must differ from JWT_SECRET. Same value as ms-transactions JWT_INTERNAL_SECRET.
JWT_INTERNAL_SECRET=change-me-internal-jwt
# ms-transactions base URL (used by `make run` on the host only). Docker Compose ignores this and uses fixed ilia-ms-transactions:3001 in docker-compose.yml.
TRANSACTIONS_SERVICE_BASE_URL=http://localhost:3001
# Optional HTTP client timeout for wallet pre-delete check.
TRANSACTIONS_SERVICE_TIMEOUT=5s
