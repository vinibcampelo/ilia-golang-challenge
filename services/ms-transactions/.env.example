# Copy to `.env` (`cp .env.example .env`). The `.env` file is used by:
# - Docker Compose (${...} in docker-compose.yml), loaded automatically when present.
# - `go run` / `make run` via godotenv (DOTENV_FILE, default `.env`).

# --- API (required when running the binary outside Compose) ---
PORT=3001
# Use localhost:5433 by default so this Postgres does not clash with ms-users (5432) on the host.
DATABASE_URL=postgres://transactions:transactions@localhost:5433/transactions?sslmode=disable

# --- Docker Compose Postgres service (override defaults in compose) ---
POSTGRES_USER=transactions
POSTGRES_PASSWORD=transactions
POSTGRES_DB=transactions
POSTGRES_PORT=5433

# Optional: Swagger (path relative to repo root when using `make run` from service dir)
OPENAPI_SPEC=services/ms-transactions/ms-transactions.yaml

# Optional: API
DB_PING_TIMEOUT=10s

# JWT (required): must match ms-users JWT_SECRET so access tokens from POST /auth validate here.
JWT_SECRET=change-me-in-production
