# Copy to .env or run: make run-example  (DOTENV_FILE=.env.example).
# Loaded by godotenv; override file with DOTENV_FILE=path/to/file.

# Required
PORT=3002
DATABASE_URL=postgres://users:users@localhost:5432/users?sslmode=disable

# Optional: leave empty to disable Swagger UI
OPENAPI_SPEC=ms-users.yaml

# Optional: sql.DB pool (same values as config fallbacks when unset)
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_PING_TIMEOUT=10s

# Optional: bcrypt cost (4–31); invalid or empty uses library default
BCRYPT_COST=10
